{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  // ══════════════════════════════════════════════════════════════
  //  OUTTA TIME — Back to the Future fastfetch theme
  //  Color slots ($1..$5) map to the OuttaTime Noctalia palette:
  //    $1 flame orange   $2 taillight red   $3 electric blue
  //    $4 moon cream      $5 rim gold
  //  Nerd Font terminal required for the glyph icons.
  // ══════════════════════════════════════════════════════════════

  "logo": {
    "type": "kitty-direct",
    "source": "/home/den/.config/fastfetch/delorean.png",
    "width": 40,
    "height": 20,
    "padding": { "top": 1, "left": 2, "right": 4 }
  },

  "display": {
    "separator": "  ",
    "color": {
      "keys": "#ff6a1a",
      "title": "#4fc3f7",
      "output": "#f5ede0"
    },
    "key": { "type": "icon" },
    "bar": {
      "border": { "left": "[", "right": "]" },
      "char": { "elapsed": "=", "total": "-" },
      "width": 12
    }
  },

  "modules": [
    "break",
    { "type": "custom", "format": "\u001b[38;2;79;195;247m┌─ \u001b[38;2;255;106;26m GREAT SCOTT! \u001b[38;2;79;195;247m───────────────────────┐" },
    { "type": "title", "format": "{user-name}\u001b[38;2;231;201;142m@\u001b[38;2;79;195;247m{host-name}" },
    { "type": "custom", "format": "\u001b[38;2;79;195;247m├──────────────────────────────────────────┤" },
    { "type": "os",       "key": "  Flux OS",    "keyColor": "#ff6a1a" },
    { "type": "kernel",   "key": " 󰒋 Reactor",    "keyColor": "#ff6a1a" },
    { "type": "packages", "key": " 󰏖 Parts",      "keyColor": "#ff6a1a" },
    { "type": "shell",    "key": "  Dash",       "keyColor": "#ff3b30" },
    { "type": "wm",       "key": "  Compositor", "keyColor": "#ff3b30" },
    { "type": "terminal", "key": "  Terminal",   "keyColor": "#ff3b30" },
    { "type": "uptime",   "key": " 󰅐 Drive Time", "keyColor": "#4fc3f7" },
    { "type": "custom", "format": "\u001b[38;2;79;195;247m├──────────────────────────────────────────┤" },
    { "type": "cpu",    "key": " 󰍛 Engine",    "keyColor": "#4fc3f7", "showPeCoreCount": false },
    { "type": "gpu",    "key": " 󰢮 Turbine",   "keyColor": "#4fc3f7" },
    { "type": "memory", "key": " 󰑭 Capacitor", "keyColor": "#4fc3f7", "format": "{used} / {total}" },
    { "type": "disk",   "key": " 󰋊 Storage",   "keyColor": "#4fc3f7" },
    { "type": "custom", "format": "\u001b[38;2;79;195;247m└──────────────────────────────────────────┘" },
    "break",
    { "type": "colors", "paddingLeft": 2, "symbol": "circle" },
    "break"
  ]
}
